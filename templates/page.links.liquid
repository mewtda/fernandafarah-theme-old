{%- layout none -%}
{%- comment -%}
  Bio do Instagram — Fernanda Farah (/pages/links)
  Página standalone (sem header/footer do tema), réplica de ecomsessions.com/bio/fernanda1
  + botão "Trocas e Devoluções" (Pode Trocar).
  Para usar: Admin > Loja virtual > Páginas > crie a página "links" e escolha o modelo "page.links".
{%- endcomment -%}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Fernanda Farah — Links</title>
<meta name="description" content="Fernanda Farah — moda feminina. Compre pelo site ou pelo WhatsApp.">
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="Fernanda Farah — Links">
<meta property="og:description" content="Compre pelo site ou pelo WhatsApp.">
<meta property="og:image" content="https://fernandafarah.com.br/cdn/shop/files/BANNER_QUADRADO_1.png?v=1794507497&width=1200">
<meta property="og:type" content="website">
<link rel="icon" href="{{ 'bio-links-favicon.svg' | asset_url }}" type="image/svg+xml">
<link rel="preload" href="{{ 'bio-links-aileron-400.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'bio-links-aileron-600.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{{ content_for_header }}
<style>
  @font-face { font-family: 'Aileron'; src: url('{{ 'bio-links-aileron-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Aileron'; src: url('{{ 'bio-links-aileron-600.woff2' | asset_url }}') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Aileron'; src: url('{{ 'bio-links-aileron-700.woff2' | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  :root {
    box-sizing: border-box;
    color-scheme: light;
    --paper: #ffffff;
    --card: #ffffff;
    --ink: #000000;
    --muted: #757575;
    --line: #e2e2e2;
    --sans: 'Aileron', system-ui, sans-serif;
  }
  * { box-sizing: inherit; margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    padding: 0 16px calc(48px + env(safe-area-inset-bottom, 0px));
  }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; text-decoration: none; }
  .page { max-width: 480px; margin: 0 auto; }

  .rise { opacity: 0; transform: translateY(14px); animation: rise .7s cubic-bezier(.2,.7,.2,1) forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }
  .d1 { animation-delay: .05s } .d2 { animation-delay: .15s }
  @media (prefers-reduced-motion: reduce) { .rise { animation: none; opacity: 1; transform: none; } }

  header { text-align: center; padding: 44px 0 6px; }
  .logo { width: min(250px, 66%); margin: 0 auto 18px; }

  .sec { margin-top: 26px; }

  .links { display: grid; gap: 10px; }
  .link {
    display: flex; align-items: center; gap: 14px;
    background: var(--card); border: 1px solid var(--line); border-radius: 14px;
    padding: 15px 18px;
    font-size: 11.5px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
    transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s, border-color .3s;
  }
  .link:hover, .link:focus-visible { transform: translateY(-2px); border-color: var(--ink); box-shadow: 0 10px 24px -14px rgba(20,20,20,.35); }
  .link svg { width: 17px; height: 17px; flex: none; stroke: var(--ink); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .link .icon-img { width: 17px; height: 17px; flex: none; object-fit: contain; }
  .link .arrow { margin-left: auto; width: 13px; height: 13px; stroke: var(--muted); }
  .link small { display: block; font-size: 10px; font-weight: 500; letter-spacing: 1px; color: var(--muted); margin-top: 2px; }
</style>
</head>
<body>
<div class="page">

  <header class="rise d1">
    <img class="logo" src="{{ 'bio-links-logo.png' | asset_url }}" alt="Fernanda Farah" width="1159" height="84">
  </header>

  <section class="sec rise d2">
    <div class="links">

      <a class="link" href="https://fernandafarah.com.br/?utm_source=bioinstagram&utm_medium=bio&utm_content=link-site" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M6 7h12l1.5 14h-15L6 7Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
        Compre pelo site
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

      <a class="link" href="https://wa.me/5531998008081?utm_source=bioinstagram&utm_medium=bioinstagram&utm_campaign=vendawpp&utm_term=vendawpp&utm_content=conversao&utm_source_platform=whatsapp&utm_marketing_tactic=conversao" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M8.8 9.2c.3 2.6 3.4 5.7 6 6l1.4-1.4-2.2-1.4-1 .7a5.4 5.4 0 0 1-2.1-2.1l.7-1-1.4-2.2-1.4 1.4Z"/></svg>
        <span>Compre pelo WhatsApp<small>com a Lívia</small></span>
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

      <a class="link" href="https://api.whatsapp.com/send?phone=5531998428081" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M8.8 9.2c.3 2.6 3.4 5.7 6 6l1.4-1.4-2.2-1.4-1 .7a5.4 5.4 0 0 1-2.1-2.1l.7-1-1.4-2.2-1.4 1.4Z"/></svg>
        <span>Compre pelo WhatsApp<small>com a Gabriela</small></span>
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

      <a class="link" href="https://maps.app.goo.gl/poVR53esA9Vy81VB8" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M12 21s-7-5.8-7-11a7 7 0 0 1 14 0c0 5.2-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span>Loja física<small>Belvedere · Belo Horizonte</small></span>
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

      <a class="link" href="https://wa.me/5531971109057" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M21 8v8h-3l-4 4v-4H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3Z"/></svg>
        Ajuda com meu pedido
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

      <a class="link" href="https://podetrocar.fernandafarah.com.br/" target="_blank" rel="noopener">
        <img class="icon-img" src="{{ 'bio-links-pode-trocar.svg' | asset_url }}" alt="" width="17" height="17">
        Trocas e Devoluções
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

      <a class="link" href="https://wa.me/5531998428081" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
        <span>SAC<small>central de reclamações · ouvidoria</small></span>
        <svg class="arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>

    </div>
  </section>

</div>
</body>
</html>
