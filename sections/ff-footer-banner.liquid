{%- comment -%}
  Banner largura total colado acima do rodapé (grupo do footer = aparece em todas as páginas).
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile | default: img
-%}
{%- if img != blank -%}
  <style>
    .ff-footer-banner { display: block; line-height: 0; margin: 0; }
    .ff-footer-banner picture, .ff-footer-banner img { display: block; width: 100%; height: auto; }
  </style>
  <div class="ff-footer-banner">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" aria-label="{{ section.settings.alt | default: shop.name | escape }}">{%- endif -%}
    <picture>
      <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w, {{ img_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
      {{ img | image_url: width: 2400 | image_tag:
        loading: 'lazy',
        alt: section.settings.alt,
        sizes: '100vw',
        widths: '1000, 1400, 1800, 2400'
      }}
    </picture>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Banner acima do rodapé",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem (computador)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem (celular)", "info": "Se vazio, usa a imagem do computador." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "alt", "label": "Texto alternativo" }
  ],
  "presets": [
    { "name": "Banner acima do rodapé" }
  ]
}
{% endschema %}
