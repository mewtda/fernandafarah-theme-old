{%- comment -%}
  Category tiles — 4 colunas full-bleed (2 no celular), imagem 2:3,
  título sobreposto embaixo à esquerda.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .ff-cats {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .ff-cats {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .ff-cat__overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}),
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 250.0 }}) 28%,
      rgba(0, 0, 0, 0) 55%
    );
  }
{%- endstyle -%}

<style>
  .ff-cat { position: relative; overflow: hidden; margin: 0; }
  .ff-cat__link { display: block; color: #fff; text-decoration: none; }
  .ff-cat__media { position: relative; aspect-ratio: 2 / 3; overflow: hidden; background: #e9e5df; }
  .ff-cat__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .ff-cat__link:hover .ff-cat__media img,
  .ff-cat__link:focus-visible .ff-cat__media img { transform: scale(1.04); }
  .ff-cat__overlay { position: absolute; inset: 0; pointer-events: none; }
  .ff-cat__label {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
    display: flex; flex-direction: column; align-items: center;
    padding: 0 14% clamp(28px, 3.2vw, 48px);
    color: #fff; text-align: center; pointer-events: none;
  }
  .ff-cat__kicker {
    margin: 0 0 10px; font-family: var(--body-font); font-weight: 400;
    font-size: 12px; line-height: 1.3; letter-spacing: .14em; text-transform: uppercase;
  }
  .ff-cat__title {
    display: block; width: 100%; box-sizing: border-box; margin: 0;
    padding: 18px 12px; border: 1px solid #fff; background: transparent;
    color: #fff; font-family: var(--body-font); font-weight: 400; font-style: normal;
    font-size: 13px; line-height: 1.2; letter-spacing: .18em; text-transform: uppercase;
    transition: background .3s ease, color .3s ease;
  }
  .ff-cat__link:hover .ff-cat__title,
  .ff-cat__link:focus-visible .ff-cat__title { background: #fff; color: #000; }
  @media (max-width: 749px) {
    .ff-cat__label { padding: 0 7% 32px; }
    .ff-cat__title { padding: 14px 8px; font-size: 12px; letter-spacing: .14em; }
    .ff-cat__kicker { font-size: 11px; margin-bottom: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ff-cat__media img { transition: none; }
    .ff-cat__link:hover .ff-cat__media img { transform: none; }
  }
</style>

<section class="ff-cats" aria-label="{{ section.settings.aria_label | escape }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign collection_obj = collections[block.settings.collection]
      assign title = block.settings.collection_title | default: collection_obj.title
      assign image = block.settings.collection_image | default: collection_obj.featured_image
      assign url = collection_obj.url | default: '#'
    -%}
    <div class="ff-cat" {{ block.shopify_attributes }}>
      <a class="ff-cat__link" href="{{ url }}">
        <div class="ff-cat__media">
          {%- if image != blank -%}
            {{ image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              alt: title,
              sizes: '(max-width: 749px) 50vw, 25vw',
              widths: '360, 540, 720, 900, 1200, 1600'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="ff-cat__overlay"></span>
        </div>
        <div class="ff-cat__label">
          {%- if block.settings.subtitle != blank -%}
            <p class="ff-cat__kicker">{{ block.settings.subtitle | escape }}</p>
          {%- endif -%}
          <h3 class="ff-cat__title">{{ title | escape }}</h3>
        </div>
      </a>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Categorias (blocos)",
  "tag": "div",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Rótulo de acessibilidade", "default": "Explore a coleção" },
    { "type": "range", "id": "columns_desktop", "label": "Colunas no computador", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Colunas no celular", "default": "2", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "range", "id": "gap", "label": "Espaço entre blocos", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "overlay_opacity", "label": "Escurecimento na base da imagem", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Categoria",
      "limit": 8,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "collection_image", "label": "Imagem", "info": "Se vazio, usa a imagem da coleção. Proporção 2:3 (vertical)." },
        { "type": "text", "id": "collection_title", "label": "Título", "info": "Se vazio, usa o nome da coleção." },
        { "type": "text", "id": "subtitle", "label": "Subtítulo (opcional)", "info": "Texto pequeno acima do título, ex.: \"Blusas e camisas\"." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias (blocos)",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
