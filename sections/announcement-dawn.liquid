{%- liquid
  assign section_st = section.settings
  assign announcements = section.blocks | where: 'type', 'announcement'
  assign total = announcements.size
-%}
{%- if total > 0 -%}
  {%- style -%}
    #AnnouncementDawn-{{ section.id }} {
      --ad-font-size: {{ section_st.font_size }}px;
      --ad-font-weight: {{ section_st.font_weight }};
      --ad-letter-spacing: {{ section_st.letter_spacing | divided_by: 10.0 }}px;
      padding-top: {{ section_st.padding_top }}px;
      padding-bottom: {{ section_st.padding_bottom }}px;
    }
    .announcement-dawn {
      position: relative;
      {% if section_st.show_separator_line %}border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0, 0, 0), 0.08);{% endif %}
    }
    .announcement-dawn__inner {
      display: flex;
      align-items: center;
      justify-content: center;
      max-width: 60rem;
      margin: 0 auto;
      padding: 0 1rem;
    }
    .announcement-dawn__viewport {
      position: relative;
      flex: 1 1 auto;
      overflow: hidden;
      min-width: 0;
    }
    .announcement-dawn__track {
      display: grid;
    }
    .announcement-dawn__slide {
      grid-area: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      opacity: 0;
      visibility: hidden;
      transform: translateX(0);
      transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s;
    }
    .announcement-dawn__slide.is-active {
      opacity: 1;
      visibility: visible;
    }
    .announcement-dawn__slide.is-leaving-left { transform: translateX(-2rem); }
    .announcement-dawn__slide.is-leaving-right { transform: translateX(2rem); }
    .announcement-dawn__text,
    .announcement-dawn__text a {
      margin: 0;
      font-size: var(--ad-font-size);
      font-weight: var(--ad-font-weight);
      letter-spacing: var(--ad-letter-spacing);
      line-height: 1.5;
      color: inherit;
    }
    .announcement-dawn__link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: inherit;
      text-decoration: none;
    }
    .announcement-dawn__link:hover .announcement-dawn__text {
      text-decoration: underline;
      text-underline-offset: 0.3rem;
    }
    .announcement-dawn--uppercase .announcement-dawn__text { text-transform: uppercase; }
    .announcement-dawn__button {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 4.4rem;
      height: 4.4rem;
      margin: -1rem 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.75;
      transition: opacity 0.2s, transform 0.2s;
    }
    .announcement-dawn__button:hover { opacity: 1; }
    .announcement-dawn__button--prev:hover { transform: translateX(-2px); }
    .announcement-dawn__button--next:hover { transform: translateX(2px); }
    .announcement-dawn__button svg { width: 1rem; height: 1rem; }
    @media (prefers-reduced-motion: reduce) {
      .announcement-dawn__slide { transition: none; transform: none !important; }
    }
  {%- endstyle -%}

  <announcement-dawn
    id="AnnouncementDawn-{{ section.id }}"
    class="announcement-dawn gradient color-{{ section_st.color_scheme }}{% if section_st.uppercase %} announcement-dawn--uppercase{% endif %}{% unless section_st.show_mobile %} hidden block-1025{% endunless %}"
    role="region"
    aria-roledescription="carousel"
    aria-label="Anúncios"
    data-autoplay="{{ section_st.auto_rotate }}"
    data-speed="{{ section_st.change_every }}"
  >
    <div class="announcement-dawn__inner">
      {%- if total > 1 -%}
        <button type="button" class="announcement-dawn__button announcement-dawn__button--prev" data-dir="-1" aria-label="Anúncio anterior">
          <svg viewBox="0 0 10 6" fill="none" aria-hidden="true" style="transform: rotate(90deg)">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
          </svg>
        </button>
      {%- endif -%}
      <div class="announcement-dawn__viewport">
        <div class="announcement-dawn__track" aria-live="{% if section_st.auto_rotate %}off{% else %}polite{% endif %}">
          {%- for block in announcements -%}
            <div
              class="announcement-dawn__slide{% if forloop.first %} is-active{% endif %}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} de {{ total }}"
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-dawn__link"{% unless forloop.first %} tabindex="-1"{% endunless %}>
                  <p class="announcement-dawn__text">{{ block.settings.text | escape }}</p>
                  <svg viewBox="0 0 14 10" width="12" height="9" fill="none" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"/>
                  </svg>
                </a>
              {%- else -%}
                <p class="announcement-dawn__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if total > 1 -%}
        <button type="button" class="announcement-dawn__button announcement-dawn__button--next" data-dir="1" aria-label="Próximo anúncio">
          <svg viewBox="0 0 10 6" fill="none" aria-hidden="true" style="transform: rotate(-90deg)">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </announcement-dawn>

  <script>
    if (!customElements.get('announcement-dawn')) {
      customElements.define(
        'announcement-dawn',
        class AnnouncementDawn extends HTMLElement {
          connectedCallback() {
            this.slides = Array.from(this.querySelectorAll('.announcement-dawn__slide'));
            this.index = 0;
            if (this.slides.length < 2) return;
            this.querySelectorAll('[data-dir]').forEach((btn) =>
              btn.addEventListener('click', () => {
                this.go(this.index + Number(btn.dataset.dir), Number(btn.dataset.dir));
                this.restart();
              })
            );
            this.autoplay = this.dataset.autoplay === 'true';
            this.delay = (Number(this.dataset.speed) || 5) * 1000;
            ['mouseenter', 'focusin'].forEach((e) => this.addEventListener(e, () => this.stop()));
            ['mouseleave', 'focusout'].forEach((e) => this.addEventListener(e, () => this.start()));
            if (window.Shopify && window.Shopify.designMode) {
              document.addEventListener('shopify:block:select', (event) => {
                const i = this.slides.findIndex((s) => s.contains(event.target));
                if (i > -1) {
                  this.stop();
                  this.go(i, i > this.index ? 1 : -1);
                }
              });
              document.addEventListener('shopify:block:deselect', () => this.start());
            }
            this.start();
          }
          disconnectedCallback() {
            this.stop();
          }
          go(next, dir) {
            const count = this.slides.length;
            next = ((next % count) + count) % count;
            if (next === this.index) return;
            const current = this.slides[this.index];
            const incoming = this.slides[next];
            current.classList.remove('is-active');
            current.classList.add(dir > 0 ? 'is-leaving-left' : 'is-leaving-right');
            setTimeout(() => current.classList.remove('is-leaving-left', 'is-leaving-right'), 400);
            current.setAttribute('aria-hidden', 'true');
            current.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
            incoming.classList.add('is-active');
            incoming.removeAttribute('aria-hidden');
            incoming.querySelectorAll('a').forEach((a) => a.removeAttribute('tabindex'));
            this.index = next;
          }
          start() {
            if (!this.autoplay || this.timer) return;
            this.timer = setInterval(() => this.go(this.index + 1, 1), this.delay);
          }
          stop() {
            clearInterval(this.timer);
            this.timer = null;
          }
          restart() {
            this.stop();
            this.start();
          }
        }
      );
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anúncios",
  "class": "section-announcement-dawn",
  "max_blocks": 12,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Mostrar no celular",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_separator_line",
      "label": "Mostrar linha separadora",
      "default": false
    },
    {
      "type": "header",
      "content": "Rotação"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Girar anúncios automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "change_every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Trocar anúncio a cada",
      "default": 5
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Letras maiúsculas",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamanho da fonte",
      "default": 13
    },
    {
      "type": "range",
      "id": "font_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Espessura da fonte",
      "default": 400
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "label": "Espaçamento entre letras (décimos de px)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Espaço superior",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Espaço inferior",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anúncio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Bem-vinda à nossa loja"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncios",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Frete grátis acima de R$ 299" } },
        { "type": "announcement", "settings": { "text": "Parcele em até 6x sem juros" } }
      ]
    }
  ]
}
{% endschema %}
