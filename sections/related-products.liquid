{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign column_gap = section_st.column_gap
  assign items_to_show = section_st.items_to_show
  assign heading = section_st.heading
  assign description = section_st.description
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
  if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif
  assign reveal = section_st.reveal
  assign items_per_row = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile

  # ---- Origem dos produtos ----
  # products_source: 'recommendations' (padrão) ou 'compre_junto'
  assign products_source = section_st.products_source | default: 'recommendations'
  assign compre_junto_products = null
  if products_source == 'compre_junto'
    assign cj_namespace = section_st.metafield_namespace | default: 'custom'
    assign cj_key = section_st.metafield_key | default: 'compre_junto'
    assign cj_metafield = product.metafields[cj_namespace][cj_key]
    if cj_metafield != blank and cj_metafield.value != blank
      assign compre_junto_products = cj_metafield.value
    endif
  endif

  # ---- Deve ocultar a seção? ----
  # No modo "Compre junto" sem produtos no metafield, não renderiza nada.
  assign hide_section = false
  if products_source == 'compre_junto' and compre_junto_products == blank
    assign hide_section = true
  endif

  # ---- Foto do look (modo "Compre junto") ----
  assign look_image = null
  if products_source == 'compre_junto'
    if section_st.look_image_metafield != blank
      assign li_parts = section_st.look_image_metafield | strip | split: '.'
      if li_parts.size == 2
        assign li_value = product.metafields[li_parts[0]][li_parts[1]].value
        if li_value != blank
          assign look_image = li_value
        endif
      endif
    endif
    if look_image == blank and section_st.look_image != blank
      assign look_image = section_st.look_image
    endif
    if look_image == blank and section_st.look_image_source != 'none'
      if section_st.look_image_source == 'second' and product.media.size > 1
        assign look_image = product.media[1].preview_image
      elsif product.featured_media
        assign look_image = product.featured_media.preview_image
      endif
    endif
    assign look_count = compre_junto_products.size
    if look_count > items_to_show
      assign look_count = items_to_show
    endif
  endif
-%}
{%- unless hide_section -%}
  {%- capture style -%}
    --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
  {%- endcapture -%}
  {%- capture col_style -%}
--col-desktop: {{ items_per_row }};--col-number: {{ items_per_row_mobile }};{% if items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{  column_gap }}px;{% endif %}--repeat: {{ items_to_show }}; --col-mobile: {{ items_per_row_mobile }}
  {%- endcapture -%}
  <div
    class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__related-product color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      {%- if products_source != 'compre_junto' and heading != blank or products_source != 'compre_junto' and description != blank -%}
        <div class="section__header mb-33 mb-sm-20 text-{{ section_st.header_alignment }}{% if section_st.section_width == 'full_width' %} px-20{% endif %}">
          {%- if heading != blank or description != blank -%}
            <div class="secion__header-inner">
              {%- if section_st.heading != blank -%}
                <h2 class="section__header-heading heading-letter-spacing {{ header_size  }} mt-0{% if section_st.description != blank %} mb-10{% else %} mb-0{% endif %}">
                  {{ section_st.heading }}
                </h2>
              {% endif %}
              {%- if section_st.description != blank -%}
                <div class="section__header-des rich__text-m0">
                  {{ section_st.description }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {%- if products_source == 'compre_junto' -%}
        {%- comment -%} Modo "Compre junto": foto do look + carrossel com as peças do metafield {%- endcomment -%}
        <style>
          #ffLook-{{ section.id }} { --ff-look-cols: {{ items_per_row | at_most: 3 }}; --ff-look-gap: {{ column_gap | at_most: 24 }}px; }
          .ff-look__inner { display: grid; gap: 24px; }
          @media (min-width: 990px) {
            .ff-look__inner { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: start; }
            .ff-look--no-image .ff-look__inner { grid-template-columns: minmax(0, 1fr); }
          }
          .ff-look__media { position: relative; overflow: hidden; background: #f5f5f5; }
          .ff-look__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
          .ff-look__badge {
            position: absolute; left: 12px; bottom: 12px; padding: 6px 10px;
            background: #fff; color: #111; font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
          }
          .ff-look__content { min-width: 0; }
          .ff-look__header {
            display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;
            padding-bottom: 16px; margin-bottom: 24px; border-bottom: 1px solid rgba(0, 0, 0, .1);
          }
          .ff-look__eyebrow { margin: 0 0 6px; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; opacity: .6; }
          .ff-look__title { margin: 0; }
          .ff-look__desc { margin-top: 8px; }
          .ff-look__arrows { display: flex; gap: 6px; flex-shrink: 0; }
          .ff-look__arrow {
            width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
            border: 1px solid rgba(0, 0, 0, .15); border-radius: 50%; background: #fff; color: #111; cursor: pointer;
            transition: border-color .2s, opacity .2s;
          }
          .ff-look__arrow:hover { border-color: #111; }
          .ff-look__arrow[disabled] { opacity: .3; cursor: default; }
          .ff-look__track {
            display: grid; grid-auto-flow: column; grid-auto-columns: 70%; gap: 12px;
            overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
          }
          .ff-look__track::-webkit-scrollbar { display: none; }
          .ff-look__track > * { width: auto !important; min-width: 0; scroll-snap-align: start; }
          .ff-look__slide { display: flex; flex-direction: column; }
          .ff-pick { display: block; margin-top: 12px; }
          .ff-pick__label { margin: 0 0 6px; font-size: 12px; letter-spacing: .04em; color: rgba(0, 0, 0, .6); }
          .ff-pick__label span { color: #111; }
          .ff-pick__sizes { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
          .ff-pick__size {
            min-width: 40px; height: 36px; padding: 0 10px; border: 1px solid rgba(0, 0, 0, .2);
            background: #fff; color: #111; font-size: 13px; cursor: pointer; transition: border-color .15s, background-color .15s, color .15s;
          }
          .ff-pick__size:hover:not([disabled]) { border-color: #111; }
          .ff-pick__size.is-selected { background: #111; border-color: #111; color: #fff; }
          .ff-pick__size[disabled] { color: #aaa; border-color: #e5e5e5; text-decoration: line-through; cursor: not-allowed; }
          .ff-pick__add {
            width: 100%; height: 44px; border: 1px solid #111; background: #111; color: #fff;
            font-size: 12px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; cursor: pointer;
            transition: background-color .2s, color .2s, opacity .2s;
          }
          .ff-pick__add:hover:not([disabled]) { background: #fff; color: #111; }
          .ff-pick__add[disabled] { opacity: .4; cursor: not-allowed; }
          .ff-pick.is-loading .ff-pick__add { opacity: .6; pointer-events: none; }
          .ff-pick__hint { margin: 6px 0 0; font-size: 12px; color: #c0392b; }
          .ff-pick.is-missing .ff-pick__sizes { animation: ff-shake .35s; }
          @keyframes ff-shake { 25% { transform: translateX(-3px); } 75% { transform: translateX(3px); } }
          .ff-pick__form { display: none; }
          @media (min-width: 750px) {
            .ff-look__track { grid-auto-columns: calc((100% - 2 * var(--ff-look-gap)) / 3); gap: var(--ff-look-gap); }
          }
          @media (min-width: 990px) {
            .ff-look__track {
              grid-auto-columns: calc((100% - (var(--ff-look-cols) - 1) * var(--ff-look-gap)) / var(--ff-look-cols));
            }
          }
          @media (max-width: 749px) { .ff-look__arrows { display: none; } }
        </style>

        <div id="ffLook-{{ section.id }}" class="ff-look{% if look_image == blank %} ff-look--no-image{% endif %}{% if section_st.section_width == 'full_width' %} px-20{% endif %}" data-ff-look>
          <div class="ff-look__inner">
            {%- if look_image != blank -%}
              <div class="ff-look__media">
                {{
                  look_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 40vw, 100vw',
                    widths: '450, 600, 800, 1000, 1200, 1400',
                    class: 'ff-look__img',
                    alt: product.title
                }}
                <span class="ff-look__badge">{{ look_count }} {% if look_count == 1 %}peça{% else %}peças{% endif %}</span>
              </div>
            {%- endif -%}

            <div class="ff-look__content">
              <div class="ff-look__header">
                <div>
                  {%- if section_st.look_eyebrow != blank -%}
                    <p class="ff-look__eyebrow">{{ section_st.look_eyebrow }}</p>
                  {%- endif -%}
                  {%- if heading != blank -%}
                    <h2 class="ff-look__title section__header-heading heading-letter-spacing {{ header_size }}">{{ heading }}</h2>
                  {%- endif -%}
                  {%- if description != blank -%}
                    <div class="ff-look__desc rich__text-m0">{{ description }}</div>
                  {%- endif -%}
                </div>
                {%- if look_count > 1 -%}
                  <div class="ff-look__arrows">
                    <button type="button" class="ff-look__arrow" data-ff-look-prev aria-label="Anterior">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
                    </button>
                    <button type="button" class="ff-look__arrow" data-ff-look-next aria-label="Próximo">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                    </button>
                  </div>
                {%- endif -%}
              </div>

              <div class="ff-look__track" data-ff-look-track>
                {%- assign cj_count = 0 -%}
                {% for cj_product in compre_junto_products %}
                  {%- if cj_count >= items_to_show -%}
                    {%- break -%}
                  {%- endif -%}
                  <div class="ff-look__slide">
                    {% render 'product-item',
                      card_product: cj_product,
                      section_id: section.id,
                      is_compare: false,
                      template_enable_action: false,
                      template_enable_product_vendor: true,
                      template_enable_rate: true,
                      template_enable_product_short_description: false,
                      template_enable_color_swatches: true,
                      template_enable_price: true,
                      template_enable_add_cart: false,
                      template_enable_product_badges: true
                    %}
                    {% render 'ff-look-picker', card_product: cj_product, section_id: section.id %}
                  </div>
                  {%- assign cj_count = cj_count | plus: 1 -%}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        <script>
          if (!customElements.get('ff-look-picker')) {
            customElements.define('ff-look-picker', class extends HTMLElement {
              connectedCallback() {
                if (this._ready) return;
                this._ready = true;
                var read = (sel) => { var el = this.querySelector(sel); try { return el ? JSON.parse(el.textContent) : null; } catch (e) { return null; } };
                this.colorPos = parseInt(this.dataset.colorPos, 10) || 0;
                this.sizePos = parseInt(this.dataset.sizePos, 10) || 0;
                this.variants = read('[data-ff-variants]') || [];
                this.sizes = read('[data-ff-sizes]') || [];
                this.card = this.closest('.ff-look__slide');
                this.size = null;
                this.list = this.querySelector('[data-ff-size-list]');
                this.btn = this.querySelector('[data-ff-add]');
                this.hint = this.querySelector('[data-ff-hint]');
                this.form = this.querySelector('form');
                this.idInput = this.form && this.form.querySelector('[name="id"]');
                this.submit = this.querySelector('.ff-pick__submit');
                this.label = this.btn ? this.btn.textContent : '';

                if (this.card) {
                  this.card.addEventListener('click', (e) => {
                    if (e.target.closest('.product__color-swatches--js')) setTimeout(() => this.render(), 0);
                  });
                }
                if (this.btn) this.btn.addEventListener('click', () => this.add());
                this.render();
              }

              color() {
                if (!this.colorPos) return null;
                var active = this.card && this.card.querySelector('.product__color-swatches--js.active');
                if (active && active.dataset.value) return active.dataset.value;
                var first = this.variants.find((v) => v.available) || this.variants[0];
                return first ? first.options[this.colorPos - 1] : null;
              }

              match(size) {
                var color = this.color();
                return this.variants.find((v) =>
                  (!this.colorPos || color === null || v.options[this.colorPos - 1] === color) &&
                  (!this.sizePos || size === null || v.options[this.sizePos - 1] === size)
                );
              }

              render() {
                var color = this.color();
                var colorEl = this.querySelector('[data-ff-color]');
                if (colorEl) colorEl.textContent = color ? color.charAt(0) + color.slice(1).toLowerCase() : '';
                if (!this.sizePos || !this.list) { this.update(); return; }
                this.list.innerHTML = '';
                var keep = false;
                this.sizes.forEach((size) => {
                  var v = this.match(size);
                  if (!v) return;
                  var b = document.createElement('button');
                  b.type = 'button';
                  b.className = 'ff-pick__size';
                  b.textContent = size;
                  b.setAttribute('role', 'radio');
                  if (!v.available) {
                    b.disabled = true;
                    b.setAttribute('aria-label', size + ' (esgotado)');
                  } else {
                    b.addEventListener('click', () => { this.size = size; this.render(); });
                  }
                  var on = this.size === size && v.available;
                  if (on) keep = true;
                  b.classList.toggle('is-selected', on);
                  b.setAttribute('aria-checked', on ? 'true' : 'false');
                  this.list.appendChild(b);
                });
                if (!keep) this.size = null;
                var sizeEl = this.querySelector('[data-ff-size]');
                if (sizeEl) sizeEl.textContent = this.size || 'selecione';
                this.update();
              }

              update() {
                if (!this.btn) return;
                this.classList.remove('is-missing');
                if (this.hint) this.hint.hidden = true;
                var anyAvailable = this.variants.some((v) =>
                  v.available && (!this.colorPos || v.options[this.colorPos - 1] === this.color())
                );
                this.btn.disabled = !anyAvailable;
                this.btn.textContent = anyAvailable ? this.label : 'Esgotado';
              }

              add() {
                if (this.classList.contains('is-loading') || !this.form) return;
                var v = this.sizePos ? (this.size ? this.match(this.size) : null) : this.match(null);
                if (this.sizePos && !this.size) {
                  this.classList.add('is-missing');
                  if (this.hint) this.hint.hidden = false;
                  return;
                }
                if (!v || !v.available) return;
                this.idInput.disabled = false;
                this.idInput.value = v.id;
                this.classList.add('is-loading');
                var done = () => {
                  this.classList.remove('is-loading');
                  this.btn.textContent = 'Adicionado ✓';
                  setTimeout(() => this.update(), 1800);
                };
                var obs = new MutationObserver(() => {
                  if (!this.submit.classList.contains('loading')) { obs.disconnect(); done(); }
                });
                this.form.requestSubmit(this.submit);
                if (this.submit.classList.contains('loading')) {
                  obs.observe(this.submit, { attributes: true, attributeFilter: ['class'] });
                } else {
                  done();
                }
              }
            });
          }

          (function () {
            var root = document.getElementById('ffLook-{{ section.id }}');
            if (!root) return;
            var track = root.querySelector('[data-ff-look-track]');
            var prev = root.querySelector('[data-ff-look-prev]');
            var next = root.querySelector('[data-ff-look-next]');
            if (!track || !prev || !next) return;
            var update = function () {
              prev.disabled = track.scrollLeft <= 2;
              next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
            };
            var go = function (dir) {
              var item = track.firstElementChild;
              var step = item ? item.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0) : track.clientWidth;
              track.scrollBy({ left: dir * step, behavior: 'smooth' });
            };
            prev.addEventListener('click', function () { go(-1); });
            next.addEventListener('click', function () { go(1); });
            track.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update);
            update();
          })();
        </script>
      {%- else -%}
        {%- comment -%} Modo padrão: recomendações automáticas {%- endcomment -%}
        <product-recommendations
          data-section-id="{{ section.id }}"
          {% if data_free_scroll != blank %}
            data-free-scroll="{{ data_free_scroll }}"
          {% endif %}
          style="{{ col_style | strip | strip_newlines }}"
          class="products-grid__items flex flex-cols{% if column_gap < 31 %} row-gap-20 row-gap-md-30{% endif %} flex-wrap {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %} grid_scroll{% endif %}"
          data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ items_to_show }}"
          data-arrow-centerimage="1"
        >
          {% if recommendations.performed and recommendations.products_count > 0 %}
            {% for recommendation in recommendations.products %}
              {% render 'product-item',
                card_product: recommendation,
                section_id: section.id,
                is_compare: false,
                template_enable_action: true,
                template_enable_product_vendor: true,
                template_enable_rate: true,
                template_enable_product_short_description: false,
                template_enable_color_swatches: true,
                template_enable_price: true,
                template_enable_add_cart: true,
                template_enable_product_badges: true
              %}
            {% endfor %}
          {% else %}
            <p>{{ 'sections.related_products.no_product' | t }}</p>
          {% endif %}
        </product-recommendations>
      {%- endif -%}
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_width.container.label"
        },
        {
          "value": "fluid_container",
          "label": "t:sections.all.section_width.fluid_container.label"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.section_width.stretch_width.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_width.full_width.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.section_header.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.section_header.heading.label",
      "default": "Related products"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "t:sections.all.section_header.description.label"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "t:sections.all.section_header.header_size.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.all.section_header.header_size.small.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.section_header.header_size.medium.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.section_header.header_size.large.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:sections.all.section_header.alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.section_header.alignment.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.section_header.alignment.center.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.section_header.alignment.right.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.related-products.settings.products.header"
    },
    {
      "type": "select",
      "id": "products_source",
      "label": "Origem dos produtos",
      "info": "Escolha entre recomendações automáticas ou os produtos do metafield 'Compre junto'.",
      "default": "recommendations",
      "options": [
        {
          "value": "recommendations",
          "label": "Recomendações automáticas"
        },
        {
          "value": "compre_junto",
          "label": "Compre junto (metafield)"
        }
      ]
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Namespace do metafield",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Chave do metafield",
      "default": "compre_junto"
    },
    {
      "type": "text",
      "id": "look_eyebrow",
      "label": "Compre junto: subtítulo",
      "default": "Complete sua produção"
    },
    {
      "type": "text",
      "id": "look_image_metafield",
      "label": "Compre junto: metafield da foto do look",
      "info": "Opcional. Formato namespace.chave, tipo arquivo (imagem). Tem prioridade sobre as opções abaixo.",
      "default": "custom.foto_look"
    },
    {
      "type": "image_picker",
      "id": "look_image",
      "label": "Compre junto: foto fixa do look"
    },
    {
      "type": "select",
      "id": "look_image_source",
      "label": "Compre junto: sem foto definida, usar",
      "default": "featured",
