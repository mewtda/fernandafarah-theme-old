{%- liquid
  assign section_st = section.settings
  assign has_link = false
  if section_st.link != blank
    assign has_link = true
  endif
-%}
{%- style -%}
  #BlackBanner-{{ section.id }} {
    --bb-red: {{ section_st.accent_color }};
    display: block;
    background: #ffffff;
    color: #000000;
    border: 3px solid #000000;
    text-decoration: none;
  }
  #BlackBanner-{{ section.id }} .black-banner__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 10px 16px;
    flex-wrap: wrap;
  }
  #BlackBanner-{{ section.id }} .black-banner__title {
    margin: 0;
    font-size: 26px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
  }
  #BlackBanner-{{ section.id }} .black-banner__title span {
    color: var(--bb-red);
  }
  #BlackBanner-{{ section.id }} .black-banner__divider {
    width: 3px;
    height: 26px;
    background: #000000;
  }
  #BlackBanner-{{ section.id }} .black-banner__subtitle {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #000000;
  }
  #BlackBanner-{{ section.id }} .black-banner__cta {
    display: inline-block;
    padding: 8px 16px;
    background: #000000;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.2s ease;
  }
  #BlackBanner-{{ section.id }}:hover .black-banner__cta {
    background: var(--bb-red);
  }
  @media (max-width: 749px) {
    #BlackBanner-{{ section.id }} .black-banner__inner {
      flex-wrap: nowrap;
      gap: 10px;
      padding: 7px 10px;
    }
    #BlackBanner-{{ section.id }} .black-banner__title {
      font-size: 18px;
      white-space: nowrap;
    }
    #BlackBanner-{{ section.id }} .black-banner__divider {
      flex: none;
      height: 18px;
    }
    #BlackBanner-{{ section.id }} .black-banner__subtitle {
      min-width: 0;
      font-size: 10px;
      line-height: 1.2;
      letter-spacing: 0.12em;
    }
    #BlackBanner-{{ section.id }} .black-banner__cta {
      flex: none;
      padding: 6px 10px;
      font-size: 10px;
      letter-spacing: 0.12em;
    }
  }
  @media (max-width: 359px) {
    #BlackBanner-{{ section.id }} .black-banner__divider {
      display: none;
    }
  }
{%- endstyle -%}
{%- if section_st.show_mobile == false -%}
  <style>
    @media (max-width: 749px) { #BlackBanner-{{ section.id }} { display: none; } }
  </style>
{%- endif -%}
{%- if has_link -%}
  <a href="{{ section_st.link }}" id="BlackBanner-{{ section.id }}" class="black-banner">
{%- else -%}
  <div id="BlackBanner-{{ section.id }}" class="black-banner">
{%- endif -%}
  <div class="black-banner__inner">
    <p class="black-banner__title">{{ section_st.title }}{% if section_st.title_accent != blank %} <span>{{ section_st.title_accent }}</span>{% endif %}</p>
    {%- if section_st.subtitle != blank -%}
      <span class="black-banner__divider" aria-hidden="true"></span>
      <p class="black-banner__subtitle">{{ section_st.subtitle }}</p>
    {%- endif -%}
    {%- if has_link and section_st.button_label != blank -%}
      <span class="black-banner__cta">{{ section_st.button_label }}</span>
    {%- endif -%}
  </div>
{%- if has_link -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Banner Black",
  "class": "section-black-banner",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Black" },
    { "type": "text", "id": "title_accent", "label": "Destaque do título (opcional)" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Peças limitadas" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Comprar" },
    { "type": "color", "id": "accent_color", "label": "Cor de destaque", "default": "#b80000" },
    { "type": "checkbox", "id": "show_mobile", "label": "Mostrar no mobile", "default": true }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    { "name": "Banner Black" }
  ]
}
{% endschema %}
