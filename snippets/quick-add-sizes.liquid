{%- comment -%}
  Quick add com sacolinha no card de produto.
  Clica na sacola -> mostra os tamanhos da cor selecionada no card -> clica no tamanho -> adiciona ao carrinho.

  Accepts:
  - card_product: {Object} Product
  - section_id: {String}
{%- endcomment -%}
{%- if card_product.available -%}
  {%- liquid
    assign color_names = settings.color_swatch_trigger | default: 'Cor' | split: ','
    assign size_names = settings.size_trigger | default: 'Tamanho' | split: ','
    assign color_pos = 0
    assign size_pos = 0
    assign size_values = ''
    for opt in card_product.options_with_values
      assign opt_name = opt.name | strip
      assign opt_down = opt_name | downcase
      for n in color_names
        assign n_clean = n | strip
        if opt_name == n_clean
          assign color_pos = opt.position
        endif
      endfor
      for n in size_names
        assign n_clean = n | strip
        if opt_name == n_clean
          assign size_pos = opt.position
        endif
      endfor
      if size_pos == 0
        if opt_down contains 'tamanho' or opt_down == 'size' or opt_down == 'tam'
          assign size_pos = opt.position
        endif
      endif
    endfor
    assign form_id = 'qas-form-' | append: section_id | append: '-' | append: card_product.id
  -%}
  <quick-add-sizes
    class="qas"
    data-color-pos="{{ color_pos }}"
    data-size-pos="{{ size_pos }}"
  >
    <script type="application/json" data-qas-variants>
      [
        {%- for v in card_product.variants -%}
          {"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
    {%- if size_pos > 0 -%}
      <script type="application/json" data-qas-sizes>
        {%- for opt in card_product.options_with_values -%}
          {%- if opt.position == size_pos -%}{{ opt.values | json }}{%- endif -%}
        {%- endfor -%}
      </script>
    {%- endif -%}

    <button
      type="button"
      class="qas__toggle"
      aria-expanded="false"
      aria-label="Adicionar à sacola"
      title="Adicionar à sacola"
    >
      <svg class="qas__icon-bag" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 8h14l-1 12.5a1 1 0 0 1-1 .9H7a1 1 0 0 1-1-.9L5 8z"/>
        <path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>
      </svg>
      <svg class="qas__icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12.5l4.5 4.5L19 7.5"/>
      </svg>
      <span class="qas__spinner" aria-hidden="true"></span>
    </button>

    {%- if size_pos > 0 -%}
      <div class="qas__panel" role="dialog" aria-label="Selecione o tamanho" hidden>
        <div class="qas__head">
          <span class="qas__title">Selecione o tamanho</span>
          <button type="button" class="qas__close" aria-label="Fechar">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11"/></svg>
          </button>
        </div>
        <div class="qas__sizes"></div>
      </div>
    {%- endif -%}

    <product-form class="qas__form" data-hide-errors="true">
      {%- form 'product', card_product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}" disabled>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="qas__submit" tabindex="-1" aria-hidden="true"></button>
      {%- endform -%}
    </product-form>
  </quick-add-sizes>
{%- endif -%}
