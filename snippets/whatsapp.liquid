{%- comment -%} Widget WhatsApp – minimalista, sem backdrop {%- endcomment -%}
<div id="widget-whatsapp" class="ff-wa">
  <div class="ff-wa__panel" id="ff-wa-panel" role="dialog" aria-label="Tire suas dúvidas pelo WhatsApp" hidden>
    <div class="ff-wa__head">
      <p class="ff-wa__title">Tire suas dúvidas</p>
      <button type="button" class="ff-wa__close" aria-label="Fechar">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
      </button>
    </div>
    <p class="ff-wa__sub">Fale com uma de nossas personal shoppers</p>
    <ul class="ff-wa__list">
      <li>
        <a href="https://api.whatsapp.com/send?l=pt_br&phone=5531998008081" target="_blank" rel="noopener">
          <span>Personal Shopper 1</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
        </a>
      </li>
      <li>
        <a href="https://api.whatsapp.com/send?l=pt_br&phone=5531998428081" target="_blank" rel="noopener">
          <span>Personal Shopper 2</span>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
        </a>
      </li>
    </ul>
  </div>
  <button type="button" class="ff-wa__toggle" aria-expanded="false" aria-controls="ff-wa-panel">
    <svg viewBox="130 130 765 765" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M783.302 243.246c-69.329-69.387-161.529-107.619-259.763-107.658-202.402 0-367.133 164.668-367.214 367.072-.026 64.699 16.883 127.854 49.017 183.522l-52.096 190.229 194.665-51.047c53.636 29.244 114.022 44.656 175.482 44.682h.151c202.382 0 367.128-164.688 367.21-367.094.039-98.087-38.121-190.319-107.452-259.706zM523.544 808.047h-.125c-54.767-.021-108.483-14.729-155.344-42.529l-11.146-6.612-115.517 30.293 30.834-112.592-7.259-11.544c-30.552-48.579-46.688-104.729-46.664-162.379.066-168.229 136.985-305.096 305.339-305.096 81.521.031 158.154 31.811 215.779 89.482s89.342 134.332 89.312 215.859c-.066 168.243-136.984 305.118-305.209 305.118zm167.415-228.515c-9.177-4.591-54.286-26.782-62.697-29.843-8.41-3.062-14.526-4.592-20.645 4.592-6.115 9.182-23.699 29.843-29.053 35.964-5.352 6.122-10.704 6.888-19.879 2.296-9.176-4.591-38.74-14.277-73.786-45.526-27.275-24.319-45.691-54.359-51.043-63.543-5.352-9.183-.569-14.146 4.024-18.72 4.127-4.109 9.175-10.713 13.763-16.069 4.587-5.355 6.117-9.183 9.175-15.304 3.059-6.122 1.529-11.479-.765-16.07-2.293-4.591-20.644-49.739-28.29-68.104-7.447-17.886-15.013-15.466-20.645-15.747-5.346-.266-11.469-.322-17.585-.322s-16.057 2.295-24.467 11.478-32.113 31.374-32.113 76.521c0 45.147 32.877 88.764 37.465 94.885 4.588 6.122 64.699 98.771 156.741 138.502 21.892 9.45 38.982 15.094 52.308 19.322 21.98 6.979 41.982 5.995 57.793 3.634 17.628-2.633 54.284-22.189 61.932-43.615 7.646-21.427 7.646-39.791 5.352-43.617-2.294-3.826-8.41-6.122-17.585-10.714z"/></svg>
    <span>Compre pelo WhatsApp</span>
  </button>
</div>
<style>
  .ff-wa { position: fixed; right: 16px; bottom: 24px; z-index: 999; font-family: inherit; }
  .ff-wa__toggle {
    height: 40px; padding: 0 18px; border-radius: 999px; border: 1px solid #e5e5e5; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    background: #fff; color: #000; box-shadow: 0 4px 14px rgba(0,0,0,.12);
    font-family: inherit; font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; line-height: 1;
    transition: transform .2s ease;
  }
  .ff-wa__toggle:hover { transform: translateY(-2px); }
  .ff-wa__panel {
    position: absolute; right: 0; bottom: 52px; width: 300px; max-width: calc(100vw - 32px);
    background: #fff; color: #000; border: 1px solid #e5e5e5;
    box-shadow: 0 10px 30px rgba(0,0,0,.08); padding: 20px 20px 8px;
    opacity: 0; transform: translateY(8px); transition: opacity .2s ease, transform .2s ease;
  }
  .ff-wa__panel[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .ff-wa.is-open .ff-wa__panel { opacity: 1; transform: none; visibility: visible; pointer-events: auto; }
  .ff-wa__head { display: flex; align-items: center; justify-content: space-between; }
  .ff-wa__title { margin: 0; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 500; color: #000; }
  .ff-wa__close { background: none; border: 0; padding: 4px; margin: -4px; cursor: pointer; color: #000; display: flex; }
  .ff-wa__sub { margin: 6px 0 12px; font-size: 13px; color: #6b6b6b; line-height: 1.4; }
  .ff-wa__list { list-style: none; margin: 0; padding: 0; }
  .ff-wa__list li + li { border-top: 1px solid #ededed; }
  .ff-wa__list a {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0; color: #000; text-decoration: none;
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
  }
  .ff-wa__list a svg { transition: transform .2s ease; }
  .ff-wa__list a:hover svg { transform: translateX(4px); }
  @media (max-width: 767px) { .ff-wa { right: 12px; bottom: 16px; } .ff-wa__toggle { height: 38px; padding: 0 14px; font-size: 11px; } }
  /* Botão "voltar ao topo" alinhado na mesma coluna do WhatsApp, logo acima dele */
  back-to-top.back-to-top { right: 16px !important; bottom: 76px !important; width: 52px !important; height: 52px !important; box-shadow: 0 4px 14px rgba(0,0,0,.18), 0 0 0 1px rgba(255,255,255,.28) !important; }
  @media (max-width: 767px) {
    back-to-top.back-to-top { right: 12px !important; bottom: 66px !important; width: 48px !important; height: 48px !important; }
  }
</style>
<script>
  (function () {
    var root = document.getElementById('widget-whatsapp');
    if (!root) return;
    var panel = root.querySelector('.ff-wa__panel');
    var toggle = root.querySelector('.ff-wa__toggle');
    function setOpen(open) {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open);
      if (open) panel.removeAttribute('hidden'); else panel.setAttribute('hidden', '');
    }
    toggle.addEventListener('click', function () { setOpen(!root.classList.contains('is-open')); });
    root.querySelector('.ff-wa__close').addEventListener('click', function () { setOpen(false); });
    document.addEventListener('click', function (e) { if (!root.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
  })();
</script>
