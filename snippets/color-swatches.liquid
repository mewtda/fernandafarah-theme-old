                  endif
                endfor
              endif
              
              comment
                Fallback to default Shopify swatch system
              endcomment
              if swatch_value == null
                if value.swatch.image
                  assign image_url = value.swatch.image | image_url
                  assign swatch_value = 'url(' | append: image_url | append: ')'
                elsif value.swatch.color
                  assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                endif
              endif
            %}
            {%- if is_color_option -%}
              <input
                type="radio"
                id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                name="{{ option.name }}"
                value="{{ value }}"
                form="{{ product_form_id }}"
                {% if value == op_value %}
                  checked
                {% endif %}
                class="{% if is_color_option %} {% else %} js-variant-option {% endif %} visually-hidden"
              >
              <label
                class="product__color-swatches--js relative tooltip product__color-swatch inline-flex align-center rounded-50 {{ theme_st.swatch_item_type }} pointer {{ value | downcase | replace: ' ', '-' | replace: '"', "'" }} color__{{ value | downcase | replace: ' ', '-' | replace: '"', "'" }}"
                for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                data-value="{{ value }}"
                data-color="{{ value | downcase | replace: ' ', '-' | replace: '"', "'" }}"
                data-custom-value="custom__color-swatches--{{ value | downcase | replace: ' ', '-' | replace: '"', "'" }}"
                data-swatch-type="{{ swatch_item_type }}"
                data-position="{{ option.position }}"
                {% if img != blank %}
                  data-image="{{ img | image_url: width: 50 }}"
                {% endif %}
                data-option-swatch-value="{{ swatch_value }}"
                {% if swatch_value != null and color_config_type == 'Color' %}
                  style="background-color: {{ swatch_value }} !important; background-image: none !important;"
                {% endif %}
              >
                <span class="tooltip-content invisible rounded-3 absolute pointer-none">{{ value }}</span>
              </label>
            {%- else -%}
              <input
                type="radio"
                id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                name="{{ option.name }}"
                value="{{ value }}"
                form="{{ product_form_id }}"
                {% if value == op_value %}
                  checked
                {% endif %}
                class="{% if is_color_option %} {% else %} js-variant-option {% endif %} visually-hidden"
              >
              <label
                class="tooltip pointer product__color-swatches--js product__item-option inline-flex align-center border rounded-3 subheading_weight btn-hover lh-normal px-20 py-10 transition relative"
                for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
              >
                <span class="relative z-2 uppercase-first-letter">
                  {{ value }}
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </fieldset>
      {%- endfor -%}
      <script type="application/json">
        {{ product.variants | json }}
      </script>
    </variant-radios-single>
  {%- endunless -%}
{%- endif -%}
