{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* ========== CARROSSEL ========== */
  .pvc-section-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .pvc-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .pvc-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .pvc-track-{{ ai_gen_id }}.dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .pvc-slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.slide_width }}px;
    scroll-snap-align: start;
    cursor: grab;
  }

  .pvc-slide-{{ ai_gen_id }}.dragging {
    cursor: grabbing;
  }

  /* No desktop, limita a largura do slide para que vídeos portrait
     não fiquem largos demais e distoram — mantém proporção 9:16 */
  @media screen and (min-width: 750px) {
    .pvc-slide-{{ ai_gen_id }} {
      width: {{ block.settings.slide_width }}px;
      max-width: calc({{ block.settings.desktop_video_height }}px * 9 / 16);
    }
  }

  .pvc-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    /* Altura fixa no desktop para evitar distorção em vídeos portrait */
    padding-bottom: 0;
    background-color: {{ block.settings.video_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .pvc-video-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.desktop_video_height }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .pvc-video-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.aspect_ratio }}%;
    }
  }

  .pvc-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pvc-badges-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badges_top }}px;
    {% if block.settings.badges_position == 'left' %}
      left: {{ block.settings.badges_horizontal }}px;
    {% else %}
      right: {{ block.settings.badges_horizontal }}px;
    {% endif %}
    z-index: 5;
  }

  .pvc-info-{{ ai_gen_id }} {
    margin-top: {{ block.settings.info_spacing }}px;
  }

  .pvc-vendor-{{ ai_gen_id }} {
    font-size: {{ block.settings.vendor_size }}px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .pvc-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .pvc-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: {{ block.settings.price_weight }};
  }

  .pvc-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 6px;
  }

  .pvc-price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  /* ========== MODAL STORIES ========== */
  .pvc-modal-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.88);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .pvc-modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  /* Wrapper que representa "um celular" no desktop */
  .pvc-modal-inner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .pvc-modal-inner-{{ ai_gen_id }} {
      width: 390px;
      height: 90vh;
      max-height: 844px;
      border-radius: 16px;
      overflow: hidden;
    }
  }

  .pvc-modal-header-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 12px 12px 0;
    z-index: 10;
    display: flex;
    gap: 4px;
  }

  .pvc-progress-bar-{{ ai_gen_id }} {
    flex: 1;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    overflow: hidden;
  }

  .pvc-progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background: #fff;
    width: 0%;
    transition: width 0.1s linear;
  }

  .pvc-modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: 24px;
    right: 12px;
    width: 32px;
    height: 32px;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 11;
    backdrop-filter: blur(4px);
  }

  .pvc-modal-content-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #000;
  }

  .pvc-stories-track-{{ ai_gen_id }} {
    height: 100%;
    position: relative;
  }

  .pvc-story-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(100%);
    background: #000;
  }

  .pvc-story-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    z-index: 2;
  }

  .pvc-story-{{ ai_gen_id }}.prev {
    opacity: 0;
    transform: translateY(-100%);
    z-index: 1;
  }

  .pvc-story-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Badges dentro do modal */
  .pvc-story-badges-{{ ai_gen_id }} {
    position: absolute;
    top: 44px;
    left: 12px;
    z-index: 6;
  }

  /* Info panel - fundo branco com blur */
  .pvc-story-info-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 18px 16px 24px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: #1a1a1a;
    z-index: 6;
    border-top: 1px solid rgba(255, 255, 255, 0.5);
  }

  @media screen and (min-width: 750px) {
    .pvc-story-info-{{ ai_gen_id }} {
      border-radius: 0 0 16px 16px;
    }
  }

  .pvc-story-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .pvc-story-meta-left-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .pvc-story-title-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 4px;
    line-height: 1.35;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pvc-story-price-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #222;
  }

  .pvc-story-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.45;
    font-size: 13px;
    font-weight: 400;
  }

  .pvc-story-share-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    background: rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    color: #333;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .pvc-story-share-{{ ai_gen_id }}:hover {
    background: rgba(0, 0, 0, 0.12);
  }

  .pvc-story-actions-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .pvc-story-cta-{{ ai_gen_id }} {
    display: block;
    flex: 1;
    padding: 13px 16px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
    text-align: center;
    letter-spacing: 0.03em;
    box-sizing: border-box;
    transition: opacity 0.2s ease;
  }

  .pvc-story-cta-{{ ai_gen_id }}:hover {
    opacity: 0.88;
  }

  .pvc-tap-zones-{{ ai_gen_id }} {
    position: absolute;
    top: 44px;
    left: 0;
    right: 0;
    bottom: 180px;
    display: flex;
    z-index: 5;
  }

  .pvc-tap-prev-{{ ai_gen_id }},
  .pvc-tap-next-{{ ai_gen_id }} {
    flex: 1;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .pvc-slide-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_slide_width }}px;
    }

    .pvc-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="pvc-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="pvc-track-{{ ai_gen_id }}">
    {% if block.settings.product_list != blank %}
      {% for product in block.settings.product_list %}
        {% assign video_file = product.metafields.custom.video.value | first %}
        <div class="pvc-slide-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}" data-product-url="{{ product.url }}">
          <div class="pvc-video-wrapper-{{ ai_gen_id }}">
            {% if video_file != blank %}
              {% assign video_class = 'pvc-video-' | append: ai_gen_id %}
              {{ video_file | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: video_class }}
            {% else %}
              <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;">
                Sem vídeo
              </div>
            {% endif %}

            {% if block.settings.show_badges %}
              <div class="pvc-badges-{{ ai_gen_id }}">
                {% render 'product-badges', card_product: product, type: 'product_item' %}
              </div>
            {% endif %}
          </div>

          {% if block.settings.show_product_info %}
            <div class="pvc-info-{{ ai_gen_id }}">
              {% if block.settings.show_vendor and product.vendor != blank %}
                <div class="pvc-vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
              {% endif %}

              {% if block.settings.show_title %}
                <h3 class="pvc-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              {% endif %}

              {% if block.settings.show_price %}
                <div class="pvc-price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="pvc-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    <span class="pvc-price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="pvc-slide-{{ ai_gen_id }}">
          <div class="pvc-video-wrapper-{{ ai_gen_id }}">
            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;">
              Adicione produtos
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

<!-- Modal Stories -->
<div class="pvc-modal-{{ ai_gen_id }}" id="pvc-modal-{{ ai_gen_id }}">
  <div class="pvc-modal-inner-{{ ai_gen_id }}">

    <div class="pvc-modal-header-{{ ai_gen_id }}" id="pvc-progress-{{ ai_gen_id }}">
      {% if block.settings.product_list != blank %}
        {% for product in block.settings.product_list %}
          <div class="pvc-progress-bar-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}" style="cursor:pointer;">
            <div class="pvc-progress-fill-{{ ai_gen_id }}"></div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <button class="pvc-modal-close-{{ ai_gen_id }}" aria-label="Fechar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="pvc-modal-content-{{ ai_gen_id }}">
      <div class="pvc-stories-track-{{ ai_gen_id }}">
        {% if block.settings.product_list != blank %}
          {% for product in block.settings.product_list %}
            {% assign video_file = product.metafields.custom.video.value | first %}
            <div class="pvc-story-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">

              {% if video_file != blank %}
                {% assign story_video_class = 'pvc-story-video-' | append: ai_gen_id %}
                {{ video_file | video_tag: autoplay: false, loop: true, muted: false, controls: false, playsinline: true, class: story_video_class }}
              {% endif %}

              {% if block.settings.show_badges %}
                <div class="pvc-story-badges-{{ ai_gen_id }}">
                  {% render 'product-badges', card_product: product, type: 'product_item' %}
                </div>
              {% endif %}

              <div class="pvc-story-info-{{ ai_gen_id }}">
                <div class="pvc-story-meta-{{ ai_gen_id }}">
                  <div class="pvc-story-meta-left-{{ ai_gen_id }}">
                    <h3 class="pvc-story-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                    <div class="pvc-story-price-{{ ai_gen_id }}">
                      {% if product.compare_at_price > product.price %}
                        <span class="pvc-story-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                        <span>{{ product.price | money }}</span>
                      {% else %}
                        <span>{{ product.price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                  <button
                    class="pvc-story-share-{{ ai_gen_id }}"
                    aria-label="Compartilhar"
                    data-share-url="{{ product.url | prepend: shop.url }}"
                    data-share-title="{{ product.title | escape }}"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="18" cy="5" r="3"></circle>
                      <circle cx="6" cy="12" r="3"></circle>
                      <circle cx="18" cy="19" r="3"></circle>
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                  </button>
                </div>
                <div class="pvc-story-actions-{{ ai_gen_id }}">
                  <a href="{{ product.url }}" class="pvc-story-cta-{{ ai_gen_id }}">Ver produto</a>
                </div>
              </div>

            </div>
          {% endfor %}
        {% endif %}
      </div>

      <div class="pvc-tap-zones-{{ ai_gen_id }}">
        <div class="pvc-tap-prev-{{ ai_gen_id }}"></div>
        <div class="pvc-tap-next-{{ ai_gen_id }}"></div>
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  const id = '{{ ai_gen_id }}';
  const modal = document.getElementById('pvc-modal-' + id);
  const slides = document.querySelectorAll('.pvc-slide-' + id);
  const stories = document.querySelectorAll('.pvc-story-' + id);
  const progressBars = document.querySelectorAll('.pvc-modal-header-' + id + ' .pvc-progress-fill-' + id);
  const closeBtn = modal.querySelector('.pvc-modal-close-' + id);
  const tapPrev = modal.querySelector('.pvc-tap-prev-' + id);
  const tapNext = modal.querySelector('.pvc-tap-next-' + id);

  let currentStory = 0;
  let progressInterval = null;
  let progress = 0;
  const storyDuration = {{ block.settings.story_duration | default: 5 }} * 1000;

  function openModal(index) {
    currentStory = index;
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    showStory(currentStory);
  }

  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
    stopProgress();
    pauseAllVideos();
  }

  function showStory(index) {
    stopProgress();
    pauseAllVideos();

    stories.forEach((story, i) => {
      story.classList.remove('active', 'prev');
      if (i < index) {
        story.classList.add('prev');
      } else if (i === index) {
        story.classList.add('active');
      }
    });

    // Reset progress bars
    progressBars.forEach((bar, i) => {
      if (i < index) {
        bar.style.width = '100%';
      } else {
        bar.style.width = '0%';
      }
    });

    // Play current video
    const currentVideo = stories[index].querySelector('video');
    if (currentVideo) {
      currentVideo.currentTime = 0;
      currentVideo.play();
      startProgress(index, currentVideo);
    }
  }

  function startProgress(index, video) {
    progress = 0;
    const duration = video ? video.duration * 1000 : storyDuration;
    const interval = 50;

    progressInterval = setInterval(() => {
      progress += interval;
      const percent = Math.min((progress / duration) * 100, 100);
      progressBars[index].style.width = percent + '%';

      if (progress >= duration) {
        nextStory();
      }
    }, interval);
  }

  function stopProgress() {
    if (progressInterval) {
      clearInterval(progressInterval);
      progressInterval = null;
    }
  }

  function pauseAllVideos() {
    stories.forEach(story => {
      const video = story.querySelector('video');
      if (video) {
        video.pause();
      }
    });
  }

  function nextStory() {
    if (currentStory < stories.length - 1) {
      currentStory++;
      showStory(currentStory);
    } else {
      closeModal();
    }
  }

  function prevStory() {
    if (currentStory > 0) {
      currentStory--;
      showStory(currentStory);
    } else {
      showStory(0);
    }
  }

  // ── Drag-to-scroll no carrossel (desktop) ──────────────────────
  const track = document.querySelector('.pvc-track-' + id);
  let isDragging = false;
  let dragStartX = 0;
  let dragScrollLeft = 0;
  let dragMoved = false;

  track.addEventListener('mousedown', (e) => {
    isDragging = true;
    dragMoved = false;
    dragStartX = e.pageX - track.offsetLeft;
    dragScrollLeft = track.scrollLeft;
    track.classList.add('dragging');
  });

  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    e.preventDefault();
    const x = e.pageX - track.offsetLeft;
    const walk = (x - dragStartX) * 1.2;
    if (Math.abs(walk) > 4) dragMoved = true;
    track.scrollLeft = dragScrollLeft - walk;
  });

  document.addEventListener('mouseup', () => {
    isDragging = false;
    track.classList.remove('dragging');
  });

  // Abre modal apenas se nao foi drag
  slides.forEach((slide, index) => {
    slide.addEventListener('click', () => {
      if (!dragMoved) openModal(index);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  tapNext.addEventListener('click', nextStory);
  tapPrev.addEventListener('click', prevStory);

  // ── Clique nas barras de progresso para saltar ao story ────────
  const progressBarEls = document.querySelectorAll('.pvc-modal-header-' + id + ' .pvc-progress-bar-' + id);
  progressBarEls.forEach((bar) => {
    bar.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = parseInt(bar.dataset.index, 10);
      if (!isNaN(idx)) {
        currentStory = idx;
        showStory(currentStory);
      }
    });
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('active')) {
      closeModal();
    }
  });

  // Fecha ao clicar no fundo escuro (fora do inner no desktop)
  modal.addEventListener('click', (e) => {
    const inner = modal.querySelector('.pvc-modal-inner-' + id);
    if (!inner.contains(e.target)) {
      closeModal();
    }
  });

  // Botao compartilhar via Web Share API
  modal.addEventListener('click', (e) => {
    const shareBtn = e.target.closest('.pvc-story-share-' + id);
    if (!shareBtn) return;
    e.stopPropagation();
    const url = shareBtn.dataset.shareUrl;
    const title = shareBtn.dataset.shareTitle;
    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(() => {});
    } else {
      navigator.clipboard && navigator.clipboard.writeText(url).then(() => {
        const icon = shareBtn.querySelector('svg');
        if (icon) {
          const original = icon.innerHTML;
          icon.innerHTML = '<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>';
          setTimeout(() => { icon.innerHTML = original; }, 1800);
        }
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Carrossel de vídeos",
  "settings": [
    {
      "type": "header",
      "content": "Produtos"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Produtos",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Espaçamento (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
